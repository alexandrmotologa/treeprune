{
  "name": "treeprune",
  "version": "1.0.0",
  "type": "module",
  "description": "Whole-codebase static analysis and dead code pruner for TypeScript, Python, and Go",
  "main": "dist/index.js",
  "bin": {
    "treeprune": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "build:web": "npm run build --prefix web",
    "build:all": "npm run build && npm run build:web",
    "start": "node dist/cli.js",
    "dev": "tsx watch src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "static-analysis",
    "dead-code-elimination",
    "code-pruner",
    "reachability-analysis",
    "ast",
    "call-graph",
    "zombie-routes",
    "dependency-audit",
    "typescript",
    "python",
    "go"
  ],
  "author": "Alexandr Motologa",
  "license": "MIT",
  "dependencies": {
    "@babel/generator": "^7.26.5",
    "@babel/parser": "^7.26.7",
    "@babel/traverse": "^7.26.7",
    "@babel/types": "^7.26.7",
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.1.0",
    "commander": "^13.1.0",
    "fast-glob": "^3.3.3",
    "fastify": "^5.2.1",
    "picocolors": "^1.1.1",
    "recast": "^0.23.9"
  },
  "devDependencies": {
    "@types/babel__generator": "^7.6.8",
    "@types/babel__traverse": "^7.20.6",
    "@types/node": "^22.13.1",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.16.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
